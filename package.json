{
  "name": "freezefix",
  "version": "1.1.0",
  "description": "FreezeFix — Desktop ADHD productivity widget with AI companion",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "keywords": [
    "adhd",
    "productivity",
    "widget",
    "ai",
    "freezefix"
  ],
  "author": "jmenichole <j.chapman7@yahoo.com>",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jmenichole/FreezeFix.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jmenichole.freezefix",
    "productName": "FreezeFix",
    "files": [
      "**/*",
      "!**/.github/**",
      "!**/.vscode/**",
      "!**/__pycache__/**",
      "!**/*.py[cod]",
      "!**/*.code-workspace",
      "!**/*.log",
      "!**/.env*",
      "!**/*.zip",
      "!dist/**",
      "!docs/**",
      "!build/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "FreezeFix Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jmenichole",
        "repo": "FreezeFix"
      }
    ]
  }
}
